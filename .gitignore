__pycache__/
*.pyc
.venv/
__pycache__/
*.py[cod]
# temp file the guide builder swaps into place
EPG/.*.tmp

# CI build output, published by .github/workflows/android-build.yml. Only the
# small logs, screenshots and bundle metadata are committed back; installers
# are release assets and Actions artifacts.
build-out/
# With the folder ignored, this keeps a stray force-add from tracking an APK.
*.apk
# A hub export bundle is generated by hub/export_static.py into hub/dist/; a
# copy at the repository root is never a source file.
premiumtv-hub-static-site.zip

# macOS app derived data (rebuilt from the repository at package time)
macos/app/node_modules/
macos/app/dist/
macos/app/resources/bundle/
macos/app/src/renderer/vendor/
macos/app/.cache/

# Download hub derived data (rebuilt by hub/build_data.py)
hub/dist/
